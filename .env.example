# required
OVERLEAF_TOKEN=your_overleaf_git_token

# required
PROJECT_ID=your_overleaf_project_id

# Optional comma-separated project allowlist; defaults to PROJECT_ID
# OVERLEAF_ALLOWED_PROJECTS=your_overleaf_project_id

# Optional; defaults to ~/.cache/overleaf-mcp
# OVERLEAF_REPO_DIR=/absolute/path/to/overleaf-mcp-cache

# Optional when the server is installed as a wheel
# OVERLEAF_ENV_FILE=/absolute/path/to/.env

# Optional: Overleaf Git base URL (change for self-hosted instances)
# OVERLEAF_BASE_URL=git.overleaf.com
